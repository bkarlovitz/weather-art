---
import Layout from '../layouts/Layout.astro';
import WeatherScene from '../components/WeatherScene.astro';
---

<Layout title="clear day — weather art">
  <a class="back" href="/">← back</a>
  <WeatherScene scene="clear-day" intensity={0.4} wind={0.4} />
</Layout>

<style is:global>
  :root {
    --scene-fg: #f0f5f8;
    --scene-bg: linear-gradient(
      to bottom,
      #4d92c8 0%,
      #80b8d8 40%,
      #b3d2e2 75%,
      #d0e0ea 100%
    );
  }
  #weather-scene .c1 {
    color: #c8d8e2;
  }
  #weather-scene .c2 {
    color: #ffffff;
    text-shadow: 0 0 3px rgba(255, 255, 255, 0.5);
  }
</style>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    color: #ffffff;
    background: rgba(20, 40, 60, 0.55);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    backdrop-filter: blur(4px);
  }
  .back:hover {
    background: rgba(20, 40, 60, 0.8);
  }
</style>
