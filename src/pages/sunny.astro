---
import Layout from '../layouts/Layout.astro';
import WeatherScene from '../components/WeatherScene.astro';
---

<Layout title="sunny — weather art">
  <a class="back" href="/">← back</a>
  <WeatherScene scene="sunny" intensity={0.55} />
</Layout>

<style is:global>
  :root {
    --scene-fg: #fff5d0;
    --scene-bg: linear-gradient(
      to bottom,
      #4d96c8 0%,
      #80bbd8 30%,
      #b3d6e2 55%,
      #b8dcae 62%,
      #8cca6e 78%,
      #5d9c42 92%,
      #437a32 100%
    );
  }
  #weather-scene .c1 {
    color: #7a8aa8;
  }
  #weather-scene .c2 {
    color: #fff080;
    text-shadow: 0 0 6px rgba(255, 220, 100, 0.7);
  }
</style>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    color: #ffffff;
    background: rgba(20, 40, 60, 0.55);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    backdrop-filter: blur(4px);
  }
  .back:hover {
    background: rgba(20, 40, 60, 0.8);
  }
</style>
