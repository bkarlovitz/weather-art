---
import Layout from '../layouts/Layout.astro';
import WeatherScene from '../components/WeatherScene.astro';
---

<Layout title="hail — weather art">
  <a class="back" href="/">← back</a>
  <WeatherScene scene="hail" intensity={0.6} />
</Layout>

<style is:global>
  :root {
    --scene-fg: #a8b3c0;
    --scene-bg: linear-gradient(
      to bottom,
      #2a3138 0%,
      #232930 40%,
      #1c2128 80%,
      #161a1f 100%
    );
  }
  #weather-scene .c1 {
    color: #5a626c;
  }
  #weather-scene .c2 {
    color: #ffffff;
    text-shadow: 0 0 3px rgba(220, 230, 245, 0.5);
  }
</style>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    color: var(--accent);
    background: rgba(10, 14, 20, 0.7);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    backdrop-filter: blur(4px);
  }
  .back:hover {
    background: rgba(10, 14, 20, 0.9);
  }
</style>
