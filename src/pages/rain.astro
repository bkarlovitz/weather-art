---
import Layout from '../layouts/Layout.astro';
import WeatherScene from '../components/WeatherScene.astro';
---

<Layout title="rain — weather art">
  <a class="back" href="/">← back</a>
  <WeatherScene scene="rain" intensity={0.6} wind={0.1} />
</Layout>

<style is:global>
  :root {
    --scene-fg: #8aa4be;
    --scene-bg: linear-gradient(
      to bottom,
      #1c2638 0%,
      #131b2a 35%,
      #0a1018 75%,
      #060a12 100%
    );
  }
  #weather-scene .c1 {
    color: #3d556e;
  }
  #weather-scene .c2 {
    color: #cfe1f2;
    text-shadow: 0 0 3px rgba(180, 210, 235, 0.35);
  }
</style>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    color: var(--accent);
    background: rgba(10, 14, 20, 0.7);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    backdrop-filter: blur(4px);
  }
  .back:hover {
    background: rgba(10, 14, 20, 0.9);
  }
</style>
