---
import Layout from '../layouts/Layout.astro';
import WeatherScene from '../components/WeatherScene.astro';
---

<Layout title="rain — weather art">
  <a class="back" href="/">← back</a>
  <WeatherScene scene="rain" intensity={0.6} wind={0.1} />
</Layout>

<style is:global>
  :root {
    --scene-fg: #8aa4be;
    --scene-bg: linear-gradient(
      to bottom,
      #1c2638 0%,
      #131b2a 35%,
      #0a1018 75%,
      #060a12 100%
    );
  }
  #weather-scene .c1 {
    color: #3a3f5e;
  }
  #weather-scene .c2 {
    color: #455e7c;
  }
  #weather-scene .c3 {
    color: #5a7da0;
  }
  #weather-scene .c4 {
    color: #7da0c0;
  }
  #weather-scene .c5 {
    color: #b3d0e8;
    text-shadow: 0 0 2px rgba(179, 208, 232, 0.35);
  }
  #weather-scene .c6 {
    color: #e8f4ff;
    text-shadow: 0 0 4px rgba(220, 240, 255, 0.5);
  }
  #weather-scene .c7 {
    color: #8feadc;
    text-shadow: 0 0 3px rgba(143, 234, 220, 0.45);
  }
</style>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    color: var(--accent);
    background: rgba(10, 14, 20, 0.7);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    backdrop-filter: blur(4px);
  }
  .back:hover {
    background: rgba(10, 14, 20, 0.9);
  }
</style>
