---
import Layout from '../layouts/Layout.astro';
import WeatherScene from '../components/WeatherScene.astro';
---

<Layout title="storm — weather art">
  <a class="back" href="/">← back</a>
  <WeatherScene scene="storm" intensity={0.6} />
</Layout>

<style is:global>
  :root {
    --scene-fg: #5d6878;
    --scene-bg: linear-gradient(
      to bottom,
      #181d27 0%,
      #131720 40%,
      #0d1019 80%,
      #07090f 100%
    );
  }
  #weather-scene .c1 {
    color: #2f3640;
  }
  #weather-scene .c2 {
    color: #a3b3c8;
  }
  #weather-scene .c3 {
    color: #fff5d0;
    text-shadow:
      0 0 8px rgba(255, 240, 180, 0.85),
      0 0 18px rgba(255, 240, 180, 0.45);
  }
</style>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    color: var(--accent);
    background: rgba(10, 14, 20, 0.7);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    backdrop-filter: blur(4px);
  }
  .back:hover {
    background: rgba(10, 14, 20, 0.9);
  }
</style>
