---
import Layout from '../layouts/Layout.astro';
import WeatherScene from '../components/WeatherScene.astro';
---

<Layout title="fog — weather art">
  <a class="back" href="/">← back</a>
  <WeatherScene scene="fog" intensity={0.55} wind={0.2} />
</Layout>

<style is:global>
  :root {
    --scene-fg: #9aa4ad;
    --scene-bg: linear-gradient(
      to bottom,
      #2c3338 0%,
      #3d454a 35%,
      #525a60 70%,
      #686f74 100%
    );
  }
  #weather-scene .c1 {
    color: #525960;
  }
  #weather-scene .c2 {
    color: #d8dde2;
    text-shadow: 0 0 4px rgba(220, 225, 230, 0.4);
  }
</style>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    color: var(--accent);
    background: rgba(10, 14, 20, 0.7);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    backdrop-filter: blur(4px);
  }
  .back:hover {
    background: rgba(10, 14, 20, 0.9);
  }
</style>
