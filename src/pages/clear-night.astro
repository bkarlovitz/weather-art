---
import Layout from '../layouts/Layout.astro';
import WeatherScene from '../components/WeatherScene.astro';
---

<Layout title="clear night — weather art">
  <a class="back" href="/">← back</a>
  <WeatherScene scene="clear-night" />
</Layout>

<style is:global>
  :root {
    --scene-fg: #c8d0e0;
    --scene-bg: linear-gradient(
      to bottom,
      #050818 0%,
      #08102a 30%,
      #0c1838 60%,
      #0a1430 100%
    );
  }
  #weather-scene .c1 {
    color: #404a60;
  }
  #weather-scene .c2 {
    color: #ffffff;
    text-shadow: 0 0 3px rgba(220, 230, 255, 0.6);
  }
</style>

<style>
  .back {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    color: var(--accent);
    background: rgba(10, 14, 20, 0.7);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    backdrop-filter: blur(4px);
  }
  .back:hover {
    background: rgba(10, 14, 20, 0.9);
  }
</style>
